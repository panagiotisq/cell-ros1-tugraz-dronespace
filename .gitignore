# colcon build artifacts (legacy ROS2 scaffold remnants)
build/
install/
log/

# python
__pycache__/
*.pyc

# large binaries hosted externally (Google Drive) -- never commit these, see
# cell_live_ros1/README.md's "Environment setup" and drone_space/DATASET.md's
# "Data hosting" for the links + where to place the downloaded file
cell_live_ros1/cell_dronespace_bundle/checkpoint/*.pth
drone_space/map/*.ply

# dataset: large raw inputs and regenerated outputs -- never committed, see DATASET.md
drone_space/bags/
drone_space/data/

# live deployment runtime artifacts
cell_live_ros1/run/*.pid
cell_live_ros1/run/ros_home/
cell_live_ros1/run/logs/

# compiled CUDA extensions -- tied to THIS machine's exact torch/CUDA/cpython build, will
# not load elsewhere (undefined-symbol crash). Rebuild per machine, see
# cell_live_ros1/README.md's "Environment setup" (setup.py build_ext --inplace). The two
# core/*.so symlinks are kept (tiny, just link text; dangle harmlessly until rebuilt).
cell_live_ros1/cell_dronespace_bundle/code/core/visibility_package/*.so
cell_live_ros1/cell_dronespace_bundle/code/core/visibility_package/build/
cell_live_ros1/cell_dronespace_bundle/code/core/correlation_package/*.so
cell_live_ros1/cell_dronespace_bundle/code/core/correlation_package/build/
